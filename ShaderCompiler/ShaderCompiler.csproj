<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Slangc.NET" Version="2026.14.1" />
  </ItemGroup>

  <!-- Copy native runtime assets from Slangc.NET NuGet package into the tool output so runtime components
       like slang-glslang and spirv-opt are discoverable when the tool runs during the build. -->
  <PropertyGroup>
    <SlangPackageId>slangc.net</SlangPackageId>
  </PropertyGroup>

  <Target Name="CopySlangNativeRuntimes" AfterTargets="Build">
    <PropertyGroup>
      <!-- Prefer explicit NuGet package root; fall back to user profile .nuget/packages -->
      <_NuGetRoot Condition=" '$(NuGetPackageRoot)' != '' ">$(NuGetPackageRoot)</_NuGetRoot>
      <_NuGetRoot Condition=" '$(NuGetPackageRoot)' == '' ">$(UserProfile)\\.nuget\\packages</_NuGetRoot>
    </PropertyGroup>

    <ItemGroup>
      <SlangNativeFiles Include="$(_NuGetRoot)\\$(SlangPackageId)\\**\\runtimes\\**\\native\\**\\*.*" Condition="Exists('$(_NuGetRoot)')" />
    </ItemGroup>

    <Message Text="Found %(SlangNativeFiles.Identity)" Importance="Low" Condition="@(SlangNativeFiles) != ''" />

    <Copy SourceFiles="@(SlangNativeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="@(SlangNativeFiles) != ''" />
  </Target>

</Project>
