<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Slangc.NET" Version="2026.14.1" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopySlangNativeRuntimes" AfterTargets="Build">
    <ItemGroup>
      <SlangNativeFiles Include="$(PkgSlangc_NET)\runtimes\$(NETCoreSdkRuntimeIdentifier)\native\*" />
    </ItemGroup>
    <Error Condition="'@(SlangNativeFiles)' == ''" Text="Slang native assets are missing for host $(NETCoreSdkRuntimeIdentifier)." />
    <Copy SourceFiles="@(SlangNativeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
